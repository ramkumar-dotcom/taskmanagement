# Copy this file to .env and change values if you need to.
# .env is a secret file — never commit it to git.

# Port the API listens on locally. Vercel sets PORT for you.
PORT=4000

# Local: leave DATABASE_URL unset → SQLite file backend/data/board.db
# Production (Neon): paste the *pooled* connection string from the Neon dashboard.
# It looks like: postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL=

# Who is allowed to call this API from a browser.
# Comma-separated if you have more than one (local + Vercel).
# After the frontend is live, add: ,https://your-frontend.vercel.app
FRONTEND_ORIGIN=http://localhost:3000
