# Copy this file to .env and change values if you need to.
# .env is a secret file — never commit it to git.

# Port the API listens on. Frontend talks to this port.
PORT=4000

# Path to the SQLite file. If you leave this unset, the API uses
# backend/data/board.db  (created automatically on first start).
# DATABASE_PATH=./data/board.db

# Who is allowed to call this API from a browser.
# Local Next.js runs on http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000
